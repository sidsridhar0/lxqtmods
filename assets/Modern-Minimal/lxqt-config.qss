QWidget {
    color: #f4eefc;
    background-color: #16122a;
    selection-color: #120e22;
    selection-background-color: #8ad4ea;
}

QToolTip {
    color: #f4eefc;
    background-color: #2c2458;
    border: 2px solid #090814;
    border-radius: 8px;
    padding: 6px 9px;
}

QPushButton,
QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    color: #f4eefc;
    background-color: #2c2458;
    border: 2px solid #090814;
    border-radius: 8px;
    padding: 6px 9px;
}

QPushButton:hover,
QComboBox:hover {
    color: #120e22;
    background-color: #8ad4ea;
}

QPushButton:pressed {
    background-color: #6bb8d4;
}

QTabBar::tab {
    color: #f4eefc;
    background-color: #2a2150;
    border: 2px solid #090814;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 7px 11px;
}

QTabBar::tab:selected {
    color: #120e22;
    background-color: #8ad4ea;
}

QHeaderView::section {
    color: #f4eefc;
    background-color: #2c2458;
    border: 2px solid #090814;
    padding: 6px;
}
