LXQtPanel #BackgroundWidget {
    background: rgba(25, 27, 28, 97%);
    border-right: 3px solid #090a0a;
}

QToolTip {
    color: #eee9dc;
    background: #292c2d;
    border: 2px solid #090a0a;
    border-radius: 8px;
    padding: 6px 9px;
}

Plugin,
LXQtPanelPlugin {
    padding: 0;
    spacing: 6px;
    qproperty-moveMarkerColor: #91d7cc;
}

Plugin > QWidget,
Plugin > QWidget > QWidget {
    color: #eee9dc;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    color: #eee9dc;
    border: 2px solid transparent;
    border-radius: 9px;
    margin: 3px 5px;
    padding: 5px;
    qproperty-iconSize: 24px;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    color: #101313;
    background: #91d7cc;
    border-color: #090a0a;
}

Plugin > QToolButton:pressed,
Plugin > QWidget > QToolButton:pressed,
LXQtPanelPlugin > QToolButton:pressed {
    background: #79bdb3;
    border-color: #090a0a;
}

Plugin > QToolButton:checked,
Plugin > QWidget > QToolButton:checked,
LXQtPanelPlugin > QToolButton:checked {
    color: #101313;
    background: #91d7cc;
    border-color: #090a0a;
}
