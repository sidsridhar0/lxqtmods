LXQtPanel #BackgroundWidget {
    background: rgba(18, 16, 28, 94%);
    border-top: 2px solid #090814;
}

QToolTip {
    color: #f4eefc;
    background: #2c2458;
    border: 2px solid #090814;
    border-radius: 8px;
    padding: 6px 9px;
}

Plugin,
LXQtPanelPlugin {
    padding: 0;
    spacing: 6px;
    qproperty-moveMarkerColor: #8ad4ea;
}

Plugin > QWidget,
Plugin > QWidget > QWidget {
    color: #f4eefc;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    color: #f4eefc;
    border: 2px solid transparent;
    border-radius: 9px;
    margin: 3px 5px;
    padding: 5px;
    qproperty-iconSize: 24px;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    color: #120e22;
    background: #8ad4ea;
    border-color: #090814;
}

Plugin > QToolButton:pressed,
Plugin > QWidget > QToolButton:pressed,
LXQtPanelPlugin > QToolButton:pressed {
    background: #6bb8d4;
    border-color: #090814;
}

Plugin > QToolButton:checked,
Plugin > QWidget > QToolButton:checked,
LXQtPanelPlugin > QToolButton:checked {
    color: #120e22;
    background: #8ad4ea;
    border-color: #090814;
}
