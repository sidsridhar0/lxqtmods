QToolTip {
    color: #f4eefc;
    background: #2c2458;
    border: 2px solid #090814;
    border-radius: 8px;
    padding: 6px 9px;
}

QWidget {
    color: #f4eefc;
    background-color: #16122a;
    selection-color: #120e22;
    selection-background-color: #8ad4ea;
}

QLineEdit {
    background-color: #2a2150;
    border: 2px solid #090814;
    border-radius: 8px;
    padding: 7px 10px;
}
