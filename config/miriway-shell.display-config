    - card-id: 0
      eDP-1:
        state: enabled
        mode: 1920x1080@60.0
        position: [0, 0]
        orientation: normal
        scale: 1
        group: 1
      DisplayPort-1:
        state: enabled
        mode: 1920x1080@60.0
        position: [0, 0]
        orientation: normal
        scale: 1
        group: 1
      DisplayPort-2:
        state: enabled
        mode: 1920x1080@60.0
        position: [0, 0]
