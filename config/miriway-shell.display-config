    - card-id: 0
      eDP-1:
        state: enabled
        mode: 1920x1080@60.0
        position: [0, 0]
        orientation: normal
        scale: 1
        group: 0
      DisplayPort-1:
        state: enabled
        mode: 3440x1440@60.0
        position: [1920, 0]
        orientation: normal
        scale: 1
        group: 0
      DisplayPort-2:
        state: enabled
        mode: 3440x1440@60.0
        position: [1920, 0]
        orientation: normal
        scale: 1
        group: 0

  side_by_side: *extended
  extended: *extended

  first-screen:
    cards:
    - card-id: 0
      eDP-1:
        state: enabled
        mode: 1920x1080@60.0
        position: [0, 0]
