[Unit]
Description=LXQt Mods desktop overlay
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/lxqtmods/dashboard.py --desktop
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=0 1

[Install]
WantedBy=graphical-session.target
