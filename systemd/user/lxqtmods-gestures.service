[Unit]
Description=LXQt Mods touchpad gestures
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
ExecStart=%h/.local/bin/lxqtmods-touchpad-gestures
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=0

[Install]
WantedBy=graphical-session.target
